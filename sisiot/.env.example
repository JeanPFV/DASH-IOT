# Copie este arquivo para "sisiot/.env" (mesma pasta do manage.py) e preencha.
# O .env NÃO vai para o GitHub (está no .gitignore).

# ---------- Supabase (Postgres) ----------
# Supabase > seu projeto > botão "Connect" > aba "Connection String"
# > Method: "Session pooler" > "View parameters"
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SENHA_DO_BANCO_DO_SUPABASE
DB_SSLMODE=require

# ---------- HiveMQ Cloud (MQTT) ----------
# Cluster > Overview: "Cluster URL" e porta TLS 8883
MQTT_HOST=b3cb723f3ee74f7699ad4b47382d9448.s1.eu.hivemq.cloud
MQTT_PORTA=8883
# Cluster > Access Management: crie uma credencial só para o backend
MQTT_USUARIO=backend_iot
MQTT_SENHA=SENHA_DA_CREDENCIAL_DO_BACKEND

# ---------- Telegram (alertas aos administradores, opcional) ----------
# 1) No Telegram, fale com o @BotFather, mande /newbot e cole o token aqui
# 2) Mande /start para o seu bot e rode: python manage.py telegram_setup
#    (ele mostra o chat id; vários ids separados por vírgula; grupo começa com -)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = também avisa cada login liberado (0 = só negados, invasão, cadastro e sensor fora do ar)
TELEGRAM_NOTIFICAR_LIBERADOS=0
